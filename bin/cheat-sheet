XDG_CONFIG_HOME = os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config"))
XDG_DATA_HOME = os.environ.get("XDG_DATA_HOME", os.path.expanduser("~/.local/share"))

PERSONAL_SHEETS_DIRS = [
    os.path.expanduser("~/.cheat-sheet/sheets"),
    os.path.expanduser("~/.cheat-sheet"),
    os.path.join(XDG_CONFIG_HOME, "cheat-sheet", "sheets"),
    os.path.join(XDG_CONFIG_HOME, "cheat-sheet"),
    os.path.join(XDG_DATA_HOME, "cheat-sheet", "sheets"),
    os.path.join(XDG_DATA_HOME, "cheat-sheet"),
]

