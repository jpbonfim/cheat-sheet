def get_theme_color(key, default=None):
    """Retrieve theme color considering active preset and direct variables."""
    if THEME_PRESET and THEME_PRESET in THEME_PRESETS:
        preset = THEME_PRESETS[THEME_PRESET]
        if key in preset:
            return preset[key]

    var_name = f"COLOR_{key.upper()}"
    return globals().get(var_name, default)


def resolve_curses_color(val, default=None):
    """Convert color string, integer, or curses constant to a curses color integer."""
    if default is None and curses is not None:
        default = curses.COLOR_WHITE

    if val is None:
        return default
    if isinstance(val, int):
        return val
    if isinstance(val, str):
        v = val.strip().lower()
        if curses is not None:
            mapping = {
                "black": curses.COLOR_BLACK,
                "red": curses.COLOR_RED,
                "green": curses.COLOR_GREEN,
                "yellow": curses.COLOR_YELLOW,
                "blue": curses.COLOR_BLUE,
                "magenta": curses.COLOR_MAGENTA,
                "cyan": curses.COLOR_CYAN,
                "white": curses.COLOR_WHITE,
                "default": -1,
                "none": -1,
                "transparent": -1,
            }
            if v in mapping:
                return mapping[v]
        if v.isdigit():
            return int(v)
    return default


def to_ansi_escape(color_val, is_bold=False, is_dim=False, is_underline=False):
    """Convert color name or integer into ANSI terminal escape code."""
    codes = []
    if is_bold:
        codes.append("1")
    if is_dim:
        codes.append("2")
    if is_underline:
        codes.append("4")

    c = resolve_curses_color(color_val, 7)
    if isinstance(c, int):
        if 0 <= c <= 7:
            ansi_map = {0: 30, 1: 31, 2: 32, 3: 33, 4: 34, 5: 35, 6: 36, 7: 37}
            codes.append(str(ansi_map.get(c, 37)))
        elif c > 7:
            codes.append(f"38;5;{c}")

    if not codes:
        return ""
    return "\033[" + ";".join(codes) + "m"


