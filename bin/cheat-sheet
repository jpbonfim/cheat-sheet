    r"^(NAME|SYNOPSIS|DESCRIPTION|OPTIONS|EXAMPLES|SEE ALSO|FILES|ENVIRONMENT|COMMANDS|"
    r"Usage:|Options:|Commands:|Arguments:|Global Options:)",
    re.IGNORECASE,
)


