#!/usr/bin/env python3
"""
cheat-sheet - Advanced command cheatsheet viewer & terminal launcher.

Features:
- Multi-source documentation: personal sheets, cheat.sh (online & cached), man pages, --help.
- Instant offline cache in ~/.cache/cheat-sheet/.
- Custom personal sheets in ~/.cheat-sheet/sheets/ and ~/.config/cheat-sheet/sheets/.
- Interactive 'c' menu with instant loading, live search filter, and Esc to cancel.
- Interactive 'a' menu to browse, filter, and paste shell aliases directly into the terminal prompt.
- Welcome guide page automatically shown when Enter is pressed on an empty prompt.
- Instant Esc response without key delay and automatic timeout for flash messages.
- Interactive command selection with Tab / Shift+Tab and full-line background highlight.
- Instant copy with 'y' (OSC 52, xclip, wl-copy, tmux buffer).
- Terminal injection with Enter (types directly into the caller tmux pane prompt).
- In-document search with '/' and 'n'/'N' navigation, featuring distinct active-match highlight
  and automatic command selection when matches hit commands or their descriptions.
- Dynamic source cycling with 't' (cheat.sh <-> man <-> --help <-> personal).
- Session history navigation with '[' / ']' or 'H' / 'L'.
- Smart word wrapping tailored for narrow side panes (e.g. 35% tmux splits).
- Native terminal color palette matching the user's theme (Nord default + Dracula, Gruvbox, etc.).
- Smooth mouse wheel scrolling and keyboard navigation.

Zero external Python dependencies (pure Python 3 standard library).
"""

import sys
import os
import re
import time
import shutil
import base64
import subprocess
import urllib.request
import urllib.error

# Ensure minimal escape sequence delay for instantaneous Esc handling
os.environ.setdefault("ESCDELAY", "25")

try:
    import curses
    import curses.ascii
except ImportError:
    curses = None


# ----------------------------------------------------------------------
# Paths & Configuration
# ----------------------------------------------------------------------

